<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <decorator-prefix>/decorators/</decorator-prefix>

    <!-- 1. Layout cho trang Quản trị Admin -->
    <mapping path="/admin/*" name="admin" decorator="admin.jsp"/>

    <!-- 2. Layout cho toàn bộ trang Web người dùng -->
    <mapping path="/*" name="web" decorator="web.jsp"/>

    <!-- 3. Loại trừ các đường dẫn không dùng Decorator Layout -->
    <mapping path="/api*" exclude="true"/>
    <mapping path="/image*" exclude="true"/>
    <mapping path="/account/login" exclude="true"/>
    <mapping path="/account/register" exclude="true"/>
    <mapping path="/account/verify" exclude="true"/>
    <mapping path="/account/forgot-password" exclude="true"/>
    <mapping path="/account/reset-password" exclude="true"/>
    <mapping path="/login.html" exclude="true"/>
    <mapping path="/index.jsp" exclude="true"/>
</sitemesh>
